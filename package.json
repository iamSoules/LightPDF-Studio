{
  "name": "lightpdf-studio",
  "private": true,
  "version": "2.1.1",
  "description": "LightPDF Studio – freier, quelloffener PDF-Reader und -Editor",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win dir zip portable",
    "dist:mac": "vite build && electron-builder --mac dir zip",
    "dist:android": "vite build && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vite": "^6.4.5"
  },
  "author": {
    "name": "LightPDF Studio"
  },
  "build": {
    "appId": "org.lightpdf.studio",
    "productName": "LightPDF Studio",
    "copyright": "MIT License",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "afterPack": "build/afterPack.cjs",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF-Dokument",
        "description": "PDF-Dokument",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "artifactName": "LightPDF-Studio-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "LightPDF-Studio-${version}-Windows-portable.exe"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "LightPDF-Studio-${version}-macOS-${arch}.${ext}",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "electronLanguages": [
      "de",
      "en-US",
      "en-GB",
      "en"
    ]
  }
}